{
  "name": "boardgame-rules-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server for the board game rules corpus (Cloudflare Worker)",
  "scripts": {
    "stage": "node scripts/stage-assets.mjs",
    "dev": "npm run stage && wrangler dev",
    "deploy": "npm run stage && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
