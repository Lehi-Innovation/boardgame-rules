    {
      "id": "SOURCE06-001",
      "severity": "P2",
      "type": "incorrect_overbroad_condition",
      "title": "Discard Chronicle denizens only at sites where an edifice actually flipped",
      "candidate_locator": {
        "path": "docs/quality/summary-qa/oath-chronicles-of-empire-and-exile/2026-11-05-batch-002957/expanded-iteration-06/summary-snapshot.md",
        "line": 304,
        "section": "Writing the Chronicle, step 3",
        "quote": "At retained sites winner does not rule, flip intact edifice to ruin and discard all denizens there."
      },
      "source_locators": [
        "Law §8.3.3, p.10: discard all denizen cards at sites where you flipped an edifice",
        "Law §7.1.4 persistent powers and §9.1 hierarchy",
        "Playbook p.4 embedded Chronicle aid, Forest Temple card: in the Chronicle do not discard sites with Beast cards"
      ],
      "explanation": "The candidate applies denizen discarding to every retained site not ruled by the winner. The Law applies it only where an intact edifice was flipped to a ruin. These are not always the same: Forest Temple can preserve a non-winner Beast-card site with no edifice during §8.3.2. Under the Law that site keeps its denizens; the summary sentence would remove them, changing the saved world and subsequent deck.",
      "recommended_change": "Replace the sentence with: Flip intact edifices at sites the winner does not rule to ruins; discard all denizens only at sites where an edifice was flipped."
    }
  ],
