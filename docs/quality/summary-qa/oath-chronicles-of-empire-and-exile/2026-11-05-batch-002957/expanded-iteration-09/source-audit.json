  "findings": [
    {
      "id": "S09-01",
      "severity": "minor",
      "category": "misleading scope / timing ambiguity",
      "candidate_location": {
        "section": "Title transfer and victory timing",
        "line": 223,
        "character_start": 30893,
        "character_end": 31007,
        "quote": "For Supremacy, transfer the title only at the end of a Campaign, not upon a temporary loss of site rule during it."
      },
      "description": "In the general title-transfer section, the unqualified word only can be read as prohibiting Supremacy title transfers outside Campaign actions. The surrounding normal transfer rules suggest the intended interpretation, but the restriction is broader than its source. For example, taking Bandit Crown can change who rules the most sites without a Campaign.",
      "sources": [
        {
          "path": "/home/jonny/projects/boardgame-rules/extracted/oath-current-law.txt",
          "section": "2.11 Oathkeeper Title, page 4",
          "support": "The title is always held by the player who meets the Oathkeeper goal."
        },
        {
          "path": "/home/jonny/projects/boardgame-rules/docs/quality/summary-qa/oath-chronicles-of-empire-and-exile/2026-11-05-batch-002957/errata.txt",
          "section": "Law Clarifications, 2.11 Oathkeeper Title",
          "support": "The end-of-Campaign clarification answers when to transfer during a Campaign because site rule is temporarily lost and gained inside that action."
        },
        {
          "path": "/home/jonny/projects/boardgame-rules/extracted/oath-current-law.txt",
          "section": "7.6.5 Bandit Crown, page 9",
          "support": "Holding this relic makes the player rule sites with no physical warbands, providing a non-Campaign change of site rule."
        }
      ],
      "precise_suggested_correction": "Replace the sentence with: During a Campaign, defer transfer of the Supremacy title until the action ends, rather than transferring it on a temporary loss of site rule. Outside Campaign, apply the ordinary title-transfer rules whenever the qualifying site counts change.",
      "materiality": "Small scope ambiguity; the candidate otherwise explains the ordinary title criteria. No independent factual error or omission requiring a changed core procedure was found."
    }
  ],
  "summary": "One minor ambiguity about the scope of the end-of-Campaign title-transfer timing. Full source comparison and native image review found no other factual errors, material omissions, or multiplayer scope violations."
