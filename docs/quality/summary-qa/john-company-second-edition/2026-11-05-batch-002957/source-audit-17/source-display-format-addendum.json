    ],
    "graphical_numeral_resolution": "The unreadable extracted U+001E in the p12 Lady Glencora illustration stands in the four-plus-vacancies reminder. The threshold4 is independently confirmed by the explicit words four or more on native p13; no claim is made that the control character itself encodes a legible4.",
    "applicable_errata": "Full official errata physicalLF52–79 adds No Action, forced prize reuse and empty Court wording; it does not replace the four-vacancy Writer rule.",
    "candidate": "Current candidate physicalLF102 says at least four vacancies, one additional writer once this turn and three total when doubled; correct."
  },
  "scope_of_numbering_effect": {
    "original_extract": "All original-extract read-record and report indices at/after the internal U+001E need the mapping above. The complete relevant multiplayer read remains intact.",
