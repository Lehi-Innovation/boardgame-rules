    "finding": "Helper used str.splitlines(), not physical LF splitting. U+001E inside original physicalLF1067 creates an additional logical line. The record incorrectly labels these splitlines indices as physicalLF.",
    "original_physicalLF1067_repr": "'when there are \\x1e+ vacancies.'",
    "source_LF_count": 3305,
    "source_nonterminal_physical_line_count": 3305,
    "splitlines_count": 3306,
    "additional_non_LF_line_breaks": [
      {
        "codepoint": "U+001E",
        "physicalLF": 1067,
        "count": 1
      }
    ],
    "content_effect": "The control character is consumed as a display line separator. Prefix and suffix are both visible; no relevant rule sentence was skipped. The extracted glyph itself is not a readable numeral.",
    "citation_correction": "Original extract labels1–1066 equal physicalLF. Display labels1067 and1068 are both parts of physicalLF1067. From display1069 onward subtract1. Printed Rules page citations are unchanged. Use bytes split on b\"\\n\" for true LF numbering; strip only terminal empty segment."
  },
  "operative_rule_verification": {
    "primary": "Original Rules printed p13, Enlist Writer; new native full-page rendering visually inspected.",
    "native_text": "If there are four or more vacant offices, you may place an additional writer once this turn.",
    "physicalLF_corrected": [
      1101,
      1104
    ],
    "prior_display_labels": [
      1102,
