  "substantive_findings": [
    {
      "id": "NA-SRC-001",
      "severity": "P2",
      "type": "localized_rule_conflict_in_player_reference",
      "status": "OPEN",
      "title": "Player Reference hardcodes five instead of the operative hand size and discard exceptions",
      "location": {
        "path": "rules/new-angeles.md",
        "line_1based": 359,
        "unicode_start_inclusive": 41428,
        "unicode_end_exclusive": 41443,
        "text": "discard to five"
      },
      "finding": "The at-a-glance Turn instruction gives an unconditional five-card discard target. RR3.3 and RR30.2 require discarding only to the player's hand size; printed assets change that hand size or exempt the turn from discarding. The detailed turn text and asset table elsewhere are correct, but the Player Reference can produce incorrect play on its own.",
      "practical_effect": "A player holding Floyd with 8 cards would incorrectly discard 3 despite a hand size of 10; a player holding Braintrust alone could wrongly retain 5 instead of 4; a Toshiyuki claim can exempt that turn from discarding at all.",
