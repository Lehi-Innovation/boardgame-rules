    "gaps": [
      {
        "id": "SG01",
        "status": "unresolved_exact_case",
        "manual_reference": "source-snapshot.txt 1422–1429; PDF p15",
        "faq_assessment": "No in-scope FAQ entry addresses unavailable Adult models when every model is in Combat. Rules10 is only permission to enter unexplored Rooms; Rules19 governs token reuse, not model availability.",
        "remaining_precise_gap": "When placement is required and all eight Adult models are in Combat, no qualifying model can be removed under the stated freeing procedure. The sources give no executable fallback. Do not invent cancellation, substitution, extra models or forced removal of a Combat Adult."
      },
      {
        "id": "SG02",
        "status": "unresolved_exact_case",
        "manual_reference": "source-snapshot.txt 809–816;1121–1123;2632–2634",
        "faq_assessment": "Rooms7 confirms the Intruder-board egg pile represents Nest HP. Rooms9 says a dropped Egg does not restore those HP. Neither addresses a new Egg added by Queen development after the Nest was marked destroyed. Rules26 only confirms ship destruction fulfills the objective.",
        "remaining_precise_gap": "After Queen development adds a new board Egg to a previously destroyed Nest, the sources do not explicitly say whether the destruction marker/state persists, resets, or how that affects the destroy-Nest Objective at the end. Do not transfer the dropped-Egg ruling to a different source of Egg creation."
      },
      {
        "id": "SG03",
        "status": "unresolved_wording_ambiguity",
        "manual_reference": "source-snapshot.txt 1816–1823;2650–2654; PDF pp19,25",
        "faq_assessment": "No in-scope FAQ question clarifies Contamination for a successful Egg Melee. Rooms2 addresses Noise location for thrown Grenades/Molotovs; Rooms7 and9 concern Egg location/HP.",
        "remaining_precise_gap": "The terminal if-they-miss phrase may qualify both penalties or only Wounds. Standard Melee draws Contamination before the die roll, but the Egg exception does not explicitly disambiguate a successful hit. Q18 correctly preserves this limitation without inventing an extra successful-hit draw, refund, or unconditional immunity."
      },
      {
        "id": "SG04",
        "status": "not_resolved_by_faq; downgrade_to_general_vs_specific_wording_discrepancy",
        "manual_reference": "source-snapshot.txt 1029–1037;2684–2689;3018–3020",
        "faq_assessment": "Rules25 resolves successive yellow Self-Destruct spaces only. It says nothing about a later death after Pods were relocked. Do not cite it as an official later-death ruling.",
        "remaining_precise_gap": "The general Pod entry says any death; the dedicated critical moment and reference sheet both say first death. The detailed rule also expressly allows subsequent normal relocking.",
        "recommended_treatment": "The strongest source-supported procedure is first-death-only automatic unlocking, following the dedicated rule. Keep the wording discrepancy visible; do not treat the broad Pod overview as an equally explicit new recurring-death procedure or claim the FAQ eliminated the discrepancy. Q58 remains correct for the first-death case it actually asks."
      }
    ],
