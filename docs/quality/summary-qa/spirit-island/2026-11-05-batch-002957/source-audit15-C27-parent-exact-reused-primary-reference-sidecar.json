{"exact_reused_original_group_reference_arrays":[{"group_index":0,"primary_sources":[{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/pdf-inspection/audit15/audit15-publisher-branch-claw-visible.txt","source_sha256":"73e15164ca9975c3ce8ed36d3a58174d61f545bd3e5156dfd3b8c92ec87b957a","start":1587,"end":1766,"passage":"featuring two new Spirits (Sharp Fangs Behind the Leaves and Keeper of the Forbidden Wilds) and a new Adversary (France) as well as adding Events to the Invader Phase of the game!","anchor":null},{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/card-scope-source/core-second-printing.txt","source_sha256":"8c6f6efe709a4462db08003dc7850485c784391df6999cc26ffc7a3fdf28fcc0","start":331,"end":510,"passage":"There is exactly one (minor) gameplay change, noted below. (The Fear Card \"Dahan Enheartened\".) All other changes are purely for clarity, to fix typos, or to explain rules better.","anchor":null}],"visual_source_references":[{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/card-scope-source/branch-claw-rulebook-p6.png","source_sha256":"a084156537729b13d3317b2896a4d115dfa19c56474df620b160448665eca5bc","region":"full face / specified region in visual manifest"},{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/card-scope-source/sky_stretches_to_shore.jpg","source_sha256":"a68717425d0c13f0dc7d916072e2349ebe164234708b7d11557f297fd6d87523","region":"full face / specified region in visual manifest"},{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/card-scope-source/cast_down_into_the_briny_deep.jpg","source_sha256":"c77a4c9b6e5b9724a6fca6f1eeb694010accc59456eed91c02cebad201cb0f94","region":"full face / specified region in visual manifest"}]},{"group_index":1,"primary_sources":[{"path":"extracted/spirit-island-rules.txt","source_sha256":"6191500cbd1c5a069bc17f1a9fe070abdf70a1cfa9b71a0fe64e22711d1da807","start":14587,"end":14616,"passage":"The Invader Deck is 12 cards:","anchor":null},{"path":"extracted/spirit-island-rules.txt","source_sha256":"6191500cbd1c5a069bc17f1a9fe070abdf70a1cfa9b71a0fe64e22711d1da807","start":13737,"end":13835,"passage":"Each player starts on a different Island Board and follows Setup instructions on the back of their","anchor":null},{"path":"docs/quality/summary-qa/batches/2026-11-05-batch-002957/source-preflight/spirit-island/living-faq-setup.txt","source_sha256":"f71f1b8c72dddf50ebc17c8515503143fbe2e2206f70525659c8218d68a5b907","start":222,"end":292,"passage":"During Setup, you get\nexactly 1\nadditional Blight in your Blight pool.","anchor":null},{"path":"docs/quality/summary-qa/batches/2026-11-05-batch-002957/source-preflight/spirit-island/living-faq-setup.txt","source_sha256":"f71f1b8c72dddf50ebc17c8515503143fbe2e2206f70525659c8218d68a5b907","start":11221,"end":11317,"passage":"There is no requirement that multiple Presence-placement instructions happen in different lands.","anchor":null},{"path":"extracted/spirit-island-rules.txt","source_sha256":"6191500cbd1c5a069bc17f1a9fe070abdf70a1cfa9b71a0fe64e22711d1da807","start":48824,"end":48925,"passage":"If you are playing with a Power Progression, instead of drawing 4 and keeping 1, simply take the next","anchor":null}],"visual_source_references":[{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/pdf-inspection/audit15/audit15-core-p6.png","source_sha256":"244f7e1f98d2c1b684b5295b5aa5d9edd0b831de3df7d0a2b5cb80fed46e9768","region":"full face / specified region in visual manifest"},{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/pdf-inspection/audit15/audit15-core-p7.png","source_sha256":"b80c406f8f4e7f0fa2e236e1208d16eacd7b1caeac9f1ccbd27e371af4f874f0","region":"full face / specified region in visual manifest"}]},{"group_index":2,"primary_sources":[{"path":"docs/quality/summary-qa/batches/2026-11-05-batch-002957/source-preflight/spirit-island/living-faq-core-game.txt","source_sha256":"874741b896dd1