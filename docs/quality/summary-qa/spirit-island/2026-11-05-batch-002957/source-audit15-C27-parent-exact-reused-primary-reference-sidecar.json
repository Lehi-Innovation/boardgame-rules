eed\" box","anchor":null}],"visual_source_references":[]},{"group_index":9,"primary_sources":[{"path":"extracted/spirit-island-rules.txt","source_sha256":"6191500cbd1c5a069bc17f1a9fe070abdf70a1cfa9b71a0fe64e22711d1da807","start":49250,"end":49293,"passage":"A replaced Invader keeps any Damage it had.","anchor":null},{"path":"docs/quality/summary-qa/batches/2026-11-05-batch-002957/source-preflight/spirit-island/living-faq-core-game.txt","source_sha256":"874741b896dd163568a7e33ee4341fe7b38db9a2834185d272d662573de3679e","start":33553,"end":33608,"passage":"The Invader/Dahan is destroyed in the destination land.","anchor":null},{"path":"docs/quality/summary-qa/batches/2026-11-05-batch-002957/source-preflight/spirit-island/living-faq-core-game.txt","source_sha256":"874741b896dd163568a7e33ee4341fe7b38db9a2834185d272d662573de3679e","start":35315,"end":35363,"passage":"Pick all of the pieces you want to replace first","anchor":null},{"path":"extracted/spirit-island-rules.txt","source_sha256":"6191500cbd1c5a069bc17f1a9fe070abdf70a1cfa9b71a0fe64e22711d1da807","start":50076,"end":50156,"passage":"“Defend 2” means “Whenever Invaders deal Damage in target land this turn, reduce","anchor":null},{"path":"docs/quality/summary-qa/batches/2026-11-05-batch-002957/source-preflight/spirit-island/living-faq-core-game.txt","source_sha256":"874741b896dd163568a7e33ee4341fe7b38db9a2834185d272d662573de3679e","start":99566,"end":99621,"passage":"+4 overall Damage, done when the threshold is resolved.","anchor":null}],"visual_source_references":[{"path":"docs/quality/summary-qa/spirit-island/2026-11-05-batch-002957/card-scope-source/concealing_shadows.jpg","source_sha256":"86f9d0bd182c9054632938c098575cfc1fb666932fcb4da9381beb2a9065730b","region":"full face / specified region in visual manifest"}]},{"group_index":10,"primary_sources":[{"path":"extracted/spirit-island-rules.txt","source_sha256":"6191500cbd1c5a069bc17f1a9fe070abdf70a1cfa9b71a0fe64e22711d1da807","start":31519,"end":31559,"passage"