/science-fiction"}], "boardgamemechanic": [{"name": "Hand Management", "sortindex": "1", "objecttype": "property", "objectid": "2040", "primarylink": 0, "itemstate": "approved", "href": "/boardgamemechanic/2040/hand-management", "canonical_link": "https://boardgamegeek.com/boardgamemechanic/2040/hand-management"}], "boardgameexpansion": [], "boardgameversion": [{"name": "English edition", "sortindex": "1", "objecttype": "version", "objectid": "165254", "primarylink": 0, "itemstate": "approved", "href": "/boardgameversion/165254/english-edition", "canonical_link": "https://boardgamegeek.com/boardgameversion/165254/english-edition"}], "expandsboardgame": [], "boardgameintegration": [], "contains": [], "containedin": [], "reimplementation": [], "reimplements": [], "boardgamefamily": [{"name": "Collectible: Collectible Card Games", "sortindex": "1", "objecttype": "family", "objectid": "6040", "primarylink": 0, "itemstate": "approved", "href": "/boardgamefamily/6040/collectible-collectible-card-games", "canonical_link": "https://boardgamegeek.com/boardgamefamily/6040/collectible-collectible-card-games"}], "videogamebg": [], "boardgamesubdomain": [{"name": "Customizable Games", "sortindex": "1", "objecttype": "family", "objectid": "4667", "primarylink": 0, "itemstate": "approved", "href": "/boardgamesubdomain/4667/customizable-games", "canonical_link": "https://boardgamegeek.com/boardgamesubdomain/4667/customizable-games"}], "boardgameaccessory": [], "cardset": []}, "linkcounts": {"boardgamedesigner": 1, "boardgamesolodesigner": 0, "boardgameartist": 27, "boardgamepublisher": 2, "boardgamedeveloper": 0, "boardgamegraphicdesigner": 0, "boardgamesculptor": 0, "boardgameeditor": 0, "boardgamewriter": 0, "boardgameinsertdesigner": 0, "boardgamehonor": 0, "boardgamecategory": 3, "boardgamemechanic": 1, "boardgameexpansion": 0, "boardgameversion": 1, "expandsboardgame": 0, "boardgameintegration": 0, "contains": 0, "containedin": 0, "reimplementation": 0, "reimplements": 0, "boardgamefamily": 1, "videogamebg": 0, "boardgamesubdomain": 1, "boardgameaccessory": 0, "cardset": 0}, "secondarynamescount": 0, "alternatenamescount": 0, "primaryname": {"nameid": "16285", "name": "Battlelords CCG", "sortindex": "1", "primaryname": "1", "translit": "Battlelords CCG"}, "alternatenames": [], "description": "<p>This is the CCG version of SSDC's Battlelords of the 23rd century RPG.</p>\n\n<p>The Battlelords Card Game pits mercenary against mercenary in a struggle for fame and fortune. The time is the late 23rd century. The field of battle is the frontier of the Fornax Galaxy. Crime. Intrigue, and warfare run rampant. You command an elite mercenary corps, ready to engage anyone or anything ... for a price. Plan carefully, act boldly, and carry a large weapon. On the frontier, we are all living on borrowed time!</p>\n\n<p>Each player (Commander) attempts to solidify the reputation of his or her mercenary company. Reputation is measured by completed missions and fame. By playing cards out on the table in a Command Display, Commanders set up shop on planets, enhance their holdings with special operations, recruit and equip mercs, send squads on missions, and bring the battle to the enemy (the other players). Successful completion of missions increases the Commander&rsquo;s Fame and improves a Battlelord&rsquo;s abilities. The Commander with the greatest Reputation over a pre-set amount at the end of any given round is the winner.</p>\n\n", "wiki": "<span class='text-muted'>This page does not exist. You can edit this page to create it.</span>", "website": {"url": false}, "imageid": "120952", "images": {"thumb": "https://cf.geekdo-images.com/2JdFdME69ZR1-sM92QouBg__small/img/DNEPkJIBXztRO-xQVH3QS59e2C0=/fit-in/200x150/filters:strip_icc()/pic120952.jpg", "micro": "https://cf.geekdo-images.com/2JdFdME69ZR1-sM92QouBg__micro/img/4SF-1dz705isd1EZj60Wfa85nLY=/fit-in/64x64/filters:strip_icc()/pic120952.jpg", "square": "https://cf.geekdo-images.com/2JdFdME69ZR1-sM92Qo